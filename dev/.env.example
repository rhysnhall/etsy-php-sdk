# Etsy SDK local test environment.
# Copy this file to dev/.env and fill in the values. dev/.env is gitignored.
#
# To rotate keys: paste the new keystring/shared secret below, then run
# `php -S localhost:3003 dev/auth.php` and reconnect to get fresh tokens.

# From https://www.etsy.com/developers/your-apps
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Must also be added as a callback URL on your Etsy app.
ETSY_REDIRECT_URI=http://localhost:3003/oauth/redirect

# Space separated. Read-only by default. Add "listings_w listings_d" to run
# `php dev/check.php --write`.
ETSY_SCOPES=listings_r shops_r

# Optional: comma separated public listing IDs used to test Listing::allByIds().
# Leave blank to use active listings from your own shop.
TEST_LISTING_IDS=

# Written automatically by dev/auth.php. You can also paste tokens here.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_ACCESS_TOKEN_EXPIRES=
ETSY_USER_ID=
ETSY_SHOP_ID=
